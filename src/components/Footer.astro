---
import Brand from './Brand.astro';
---

<footer class="footer">
	<div class="footer-container">
		<div class="footer-row footer-primary">
			<Brand />
			<nav class="footer-links" aria-label="Enlaces del pie de página">
				<a href="/demos">Demos</a>
				<a href="/contacto">Contacto</a>
				<a class="footer-social" href="https://www.instagram.com/daovez_studio/" target="_blank" rel="noreferrer" aria-label="Instagram de Daovez Studio">
					<svg class="instagram-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".75" fill="currentColor" stroke="none" /></svg>
				</a>
				<a class="footer-social" href="https://www.linkedin.com/in/daovez/" target="_blank" rel="noreferrer" aria-label="Perfil de LinkedIn de Daovez">
					<svg class="linkedin-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0H5C2.239 0 0 2.239 0 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5V5c0-2.761-2.239-5-5-5ZM8 19H5V9h3v10ZM6.5 7.732c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.784 1.764-1.75 1.764ZM20 19h-3v-5.604c0-1.337-.025-3.055-1.861-3.055-1.862 0-2.146 1.452-2.146 2.953V19h-3V9h2.881v1.367h.041c.401-.761 1.381-1.562 2.842-1.562 3.04 0 3.603 2.001 3.603 4.604V19Z" /></svg>
				</a>
			</nav>
		</div>
		<div class="footer-row footer-secondary">
			<span>© {new Date().getFullYear()} Daovez Studio</span>
			<span class="mono">Hecho con intención.</span>
		</div>
	</div>
</footer>
