---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
}

const {
	title = 'Daovez Studio — Automatización que escala contigo',
	description = 'Diseñamos sistemas digitales y automatizaciones que convierten operaciones complejas en procesos claros, medibles y escalables.',
	canonical
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050505" />
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
